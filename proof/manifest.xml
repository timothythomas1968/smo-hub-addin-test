<?xml version="1.0" encoding="UTF-8"?>
<!-- TransitionSuite connection proof: a separate test add-in with its own ID, so it never touches the TransitionSuite add-in. -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="TaskPaneApp">
  <Id>af7ef372-7863-4956-8324-7282ba746171</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Whisper Consulting</ProviderName>
  <DefaultLocale>en-GB</DefaultLocale>
  <DisplayName DefaultValue="TransitionSuite connection proof"/>
  <Description DefaultValue="Checks whether TransitionSuite can reach the programme's SharePoint site from this device."/>
  <IconUrl DefaultValue="https://timothythomas1968.github.io/smo-hub-addin-test/proof/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://timothythomas1968.github.io/smo-hub-addin-test/proof/icon-64.png"/>
  <SupportUrl DefaultValue="https://www.whisper-consulting.com"/>
  <AppDomains>
    <AppDomain>https://timothythomas1968.github.io</AppDomain>
    <AppDomain>https://login.microsoftonline.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="DialogApi" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://timothythomas1968.github.io/smo-hub-addin-test/proof/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
